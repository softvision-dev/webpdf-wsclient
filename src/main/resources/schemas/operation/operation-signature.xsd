<?xml version="1.0" encoding="utf-8" ?>
<xs:schema xmlns:tns="http://schema.webpdf.de/1.0/operation" elementFormDefault="qualified"
           targetNamespace="http://schema.webpdf.de/1.0/operation" xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:include schemaLocation="operation-common.xsd"/>
    <xs:complexType name="SignatureType">
        <xs:annotation>
            <xs:documentation>
                <p>The "Signature" web service can be used to digitally sign documents or to remove all signatures from a PDF documents.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:choice>
            <xs:element id="signatureAddId" name="add">
                <xs:annotation>
                    <xs:documentation>
                        <p>Used to add a new signature to the PDF document.</p>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:all>
                        <xs:element name="appearance" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>
                                    <p>Used to define the signature's visual appearance.</p>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="position" type="tns:SignaturePositionType" minOccurs="0"/>
                                    <xs:element name="image" type="tns:SignatureImageType" minOccurs="0"/>
                                    <xs:element name="identifierElements" type="tns:SignatureIdentifierType"
                                                minOccurs="0"/>
                                    <xs:element name="font" type="tns:SignatureFontType" minOccurs="0"/>
                                </xs:all>
                                <xs:attribute name="name" default="" type="xs:string">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <p>Name that will be displayed in the signature's left-hand side area. If no value is specified, the name of the signer is displayed in this area (CN name part from the certificate) if <code>showCommonName</code> is enabled.
                                            </p>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="identifier" default="" type="xs:string">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <p>Text that should be displayed in the signature's right-hand side text field. If a value is not specified, the field will display the name of the signatory and the name parts of the certificate (please refer to <code>&lt;identifierElements&gt;</code> further below).
                                            </p>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                                <xs:attribute name="page" default="1">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <p>Defines the page on which the signature is to be displayed.</p>
                                        </xs:documentation>
                                    </xs:annotation>
                                    <xs:simpleType>
                                        <xs:restriction base="xs:int">
                                            <xs:minInclusive value="1"/>
                                        </xs:restriction>
                                    </xs:simpleType>
                                </xs:attribute>
                                <xs:attribute name="showCommonName" default="true" type="xs:boolean">
                                    <xs:annotation>
                                        <xs:documentation>
                                            <p>Displays or hides the certificate name (CN) of the certificate in the signature's left-hand side area. A set <code>name</code> always has priority over the setting of this option.
                                            </p>
                                        </xs:documentation>
                                    </xs:annotation>
                                </xs:attribute>
                            </xs:complexType>
                        </xs:element>
                        <xs:element name="signer" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>
                                    <p>Contains a key pair (<code>&lt;keyPair&gt;</code>) consisting of the certificate (with public key) and the private key that identifies the signer (<code>&lt;signer&gt;</code>) who performs the signature. The certificate and the signer's private key must be passed as a PEM file in <code>&lt;certificate&gt;</code> and <code>&lt;privateKey&gt;</code> respectively.
                                        The element is optional. If no <code>&lt;keyPair&gt;</code> (consisting of the certificate and the private key) is passed directly, then a certificate must be selected via <code>&lt;keyName&gt;</code>, which is loaded from the server's global keystore.
                                    </p>
                                </xs:documentation>
                            </xs:annotation>
                            <xs:complexType>
                                <xs:all>
                                    <xs:element name="keyPair" type="tns:KeyPairType"/>
                                </xs:all>
                            </xs:complexType>
                        </xs:element>
                    </xs:all>
                    <xs:attributeGroup ref="tns:SignatureInfoGroup"/>
                    <xs:attribute name="certificationLevel" default="noChanges" type="tns:CertificationLevelType">
                        <xs:annotation>
                            <xs:documentation>
                                <p>This parameter defines the level of the signature.
                                    <ul>
                                        <li>none = Sign, but do not certify, the document, i.e., additional signatures and changes will be allowed.</li>
                                        <li>noChanges = Certify the document and do not allow any additional changes anymore.</li>
                                        <li>formFillingAndSignatures = Certify the document, but allow for fields to be filled out.</li>
                                        <li>formFillingAndSignaturesAndAnnotations = Certify the document, but allow for fields to be filled out and annotations to be added.</li>
                                    </ul>
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="fieldName" default="Signature1" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Defines the name of the field (in the document) in which the signature will be saved. If a field name that is not unique is declared, then a unique name will be automatically created.</p>
                                <p>
                                    <b>Be aware:</b>
                                    The field name is matched <b>case-insensitively</b>, and so is the check for a naming collision. Addressing a field the document already provides therefore selects that field even when the casing differs - <code>signature2</code> signs an existing field named <code>Signature2</code>, and no second field is created. For the same reason a requested <code>text1</code> is created as <code>text1_1</code> next to an existing field named <code>Text1</code>. Field names are case-sensitive in the PDF specification; webPDF relaxes that intentionally, so that a field a document already provides is not missed over a difference in spelling.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="keyName" default="" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Defines the name of the key (alias) that is to be used to sign the document. This option overwrites the server's configuration setting. Additional information can be found in the "Keystore" chapter.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="keyPassword" default="" type="xs:string">
                        <xs:annotation>
                            <xs:documentation>
                                <p>Used to define the password required in order to access the private key with "keyName." This option overwrites the server's configuration setting. Additional information can be found in the "Keystore" chapter.</p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                    <xs:attribute name="appendSignature" default="false" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>
                                <p>
                                    <b>Deprecated:</b>
                                    Usage of this parameter is discouraged, as it is no longer in use.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
            <xs:element name="clear">
                <xs:annotation>
                    <xs:documentation>
                        <p>Used to remove all existing signatures from the PDF document.

                        </p>
                        <p>
                            <b>Important:</b>
                            Be aware, that this will also remove probably set passwords and encryption from the document.
                        </p>
                    </xs:documentation>
                </xs:annotation>
                <xs:complexType>
                    <xs:attribute name="flatten" default="false" type="xs:boolean">
                        <xs:annotation>
                            <xs:documentation>
                                <p>When set to "true", this will render all visible signatures to the page content.

                                </p>
                                <p>
                                    <b>Important:</b>
                                    The actual signatures will still be removed! The hereby generated visual representation is not verifyable or binding and can not serve/does not count as a valid digital signature.
                                </p>
                            </xs:documentation>
                        </xs:annotation>
                    </xs:attribute>
                </xs:complexType>
            </xs:element>
        </xs:choice>
    </xs:complexType>
    <xs:attributeGroup name="SignatureInfoGroup">
        <xs:attribute name="location" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Specifies the location of the signature.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="contact" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Specifies the name of the person signing the document.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="reason" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Specifies the reason why the document is being signed.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:attributeGroup>
    <xs:simpleType name="CertificationLevelType">
        <xs:annotation>
            <xs:documentation>
                <p>This parameter defines the level of the signature.
                    <ul>
                        <li>none = Sign, but do not certify, the document, i.e., additional signatures and changes will be allowed.</li>
                        <li>noChanges = Certify the document and do not allow any additional changes anymore.</li>
                        <li>formFillingAndSignatures = Certify the document, but allow for fields to be filled out.</li>
                        <li>formFillingAndSignaturesAndAnnotations = Certify the document, but allow for fields to be filled out and annotations to be added.</li>
                    </ul>
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="noChanges"/>
            <xs:enumeration value="formFillingAndSignatures"/>
            <xs:enumeration value="formFillingAndSignaturesAndAnnotations"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="SignaturePositionType">
        <xs:annotation>
            <xs:documentation>
                <p>Used to define the position of the visual signature.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="width" default="50">
            <xs:annotation>
                <xs:documentation>
                    <p>The signature field's width</p>
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:float">
                    <xs:minInclusive value="0"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="height" default="10">
            <xs:annotation>
                <xs:documentation>
                    <p>The signature field's height</p>
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:float">
                    <xs:minInclusive value="0"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attributeGroup ref="tns:PointGroup"/>
    </xs:complexType>
    <xs:complexType name="SignatureImageType">
        <xs:annotation>
            <xs:documentation>
                <p>Used to define an image, for the visual signature, that will be drawn in the signature's background. The image itself is passed with <code>&lt;data&gt;</code>.
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:all>
            <xs:element name="data" type="tns:SignatureFileDataType"/>
        </xs:all>
        <xs:attribute name="opacity" default="50">
            <xs:annotation>
                <xs:documentation>
                    <p>Opacity of image as a percentage value between 0 and 100.</p>
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="xs:int">
                    <xs:minInclusive value="0"/>
                    <xs:maxInclusive value="100"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
        <xs:attribute name="position" default="center">
            <xs:annotation>
                <xs:documentation>
                    <p>Position of image within signature field:
                        <ul>
                            <li>center = Centred</li>
                            <li>left = Left</li>
                            <li>right = Right</li>
                        </ul>
                    </p>
                </xs:documentation>
            </xs:annotation>
            <xs:simpleType>
                <xs:restriction base="tns:SignatureImagePositionType">
                    <xs:enumeration value="center"/>
                    <xs:enumeration value="left"/>
                    <xs:enumeration value="right"/>
                </xs:restriction>
            </xs:simpleType>
        </xs:attribute>
    </xs:complexType>
    <xs:complexType name="SignatureIdentifierType">
        <xs:annotation>
            <xs:documentation>
                <p>Used to define the elements that are part of the visual signature.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="showSignedBy" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the text <code>Digitally signed by</code>. Can be overridden by the value of <code>textSignedBy</code>.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showName" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the signature <code>name</code>.
                        (If <code>name</code> has not been set, the common name (CN) part of the certificate is displayed instead.)
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showCommonName" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the common name (CN) part of the certificate.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showOrganisationUnit" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the certificate owner's suborganization/department (OU).</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showOrganisationName" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the certificate holder's organization/company (O).</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showLocal" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the location/city (L) where the certificate holder is located.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showState" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the state (S) in which the certificate holder is located.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showCountry" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the (ISO valid) country code (C) of the country in which the certificate holder is located.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showMail" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the email address (E) at which the certificate holder can be contacted.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="showDate" default="true" type="xs:boolean">
            <xs:annotation>
                <xs:documentation>
                    <p>Displays or hides the signature time.</p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="textSignedBy" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Text that is displayed when the <code>showSignedBy</code> option is enabled. If not set, then the text <code>Digitally signed by</code> is used as default.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="textDate" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Label that is displayed in front of the signature time when the <code>showDate</code> option is enabled. If not set, then the label <code>Date:</code> is used as default. A label set here is always used as given, independently of <code>locale</code>.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="dateFormat" default="iso" type="tns:SignatureDateFormatType">
            <xs:annotation>
                <xs:documentation>
                    <p>Selects how the signature time is displayed when the <code>showDate</code> option is enabled:
                        <ul>
                            <li>iso = Date and time in the form <code>yyyy-MM-dd HH:mm:ss</code>, followed by the offset from UTC, for example <code>2026-10-06 14:30:00 +02:00</code> (<code>Z</code> for UTC).</li>
                            <li>localized = Date and time in the medium format of the locale (<code>locale</code>), followed by the offset from UTC, for example <code>06.10.2026, 14:30:00 +02:00</code> for "de-DE".</li>
                        </ul>
                    </p>
                    <p>
                        <b>Note:</b>
                        "localized" takes effect only when the signature text is drawn with an embedded font (see <code>&lt;font&gt;</code>). With the PDF standard font "Helvetica", for a locale whose date format uses a script that is written right to left or needs contextual shaping (for example Arabic, Hebrew, Hindi or Thai), and if the fonts of the signature cannot display a character of the localized form, the signature time is displayed in the "iso" form. The medium format of a locale is provided by the Java runtime of the server and can differ slightly between its versions.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="timeZone" default="" type="tns:TimeZoneType">
            <xs:annotation>
                <xs:documentation>
                    <p>Sets the time zone in which the signature time is displayed when the <code>showDate</code> option is enabled, as an identifier such as "Europe/Berlin" or an offset such as "+01:00".
                    </p>
                    <p>
                        If no value is set, the time zone of the request is used: for a signature that is part of a conversion "timeZone" of the "converter" operation, then the default time zone of the "Converter" web service; otherwise the default time zone of the "Signature" web service ("timeZone" of "webservices/signature"). After that the default time zone of the server ("timeZone" of "webservices") is used, and if none is configured, the time zone of the Java runtime of the server.
                    </p>
                    <p>
                        <b>Important:</b>
                        The signing time stored in the signature is not changed; PDF viewers show it in their own local time.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
        <xs:attribute name="locale" default="" type="tns:LocaleType">
            <xs:annotation>
                <xs:documentation>
                    <p>Sets the locale of the signature time as a language tag, for example "de-DE" or "en-US". It takes effect only with the <code>dateFormat</code> "localized".
                    </p>
                    <p>
                        If no value is set, the locale of the request is used: for a signature that is part of a conversion "locale" of the "converter" operation, then the default locale of the "Converter" web service; otherwise the default locale of the "Signature" web service ("locale" of "webservices/signature"). After that the default locale of the server ("locale" of "webservices") is used, and if none is configured, the locale of the Java runtime of the server.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:simpleType name="SignatureDateFormatType">
        <xs:annotation>
            <xs:documentation>
                <p>Form of the signature time in the visual signature:
                    <ul>
                        <li>iso = Date and time in the form <code>yyyy-MM-dd HH:mm:ss</code>, followed by the offset from UTC</li>
                        <li>localized = Date and time in the medium format of the locale, followed by the offset from UTC - only with an embedded font; with the PDF standard font "Helvetica", for scripts that need shaping or are written right to left, and where the fonts cannot display it, the iso form is written (see <code>dateFormat</code>)</li>
                    </ul>
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="iso"/>
            <xs:enumeration value="localized"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="SignatureFontType">
        <xs:annotation>
            <xs:documentation>
                <p>Selects the font of the text in the visual signature.</p>
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="name" default="" type="xs:string">
            <xs:annotation>
                <xs:documentation>
                    <p>Name of the font that is used for the text of the visual signature. The font is searched in the font directories of the "Signature" web service (<code>webservices/signature/@fontPath</code>), embedded in the document as a subset that holds only the characters drawn, and the text is fitted into the signature field.</p>
                    <p>If no value is specified, the default font of the "Signature" web service applies (<code>webservices/signature/@defaultFont</code>): if it is empty, the font chain of the server is used; a font name configured there is tried first, and a character that it cannot display is drawn with the next font of the font chain that provides it. The value <code>Helvetica</code> there selects the standard font as described below.</p>
                    <p>The value <code>Helvetica</code> selects the PDF standard font "Helvetica": it is not embedded, displays only characters of the Windows Latin character set, and the text is laid out as in earlier versions. A PDF/A document whose conformance is kept when signing (<code>pdfaEditProfile</code> "noEditRestrictions") then no longer conforms to PDF/A. The value always selects this standard font, also if a font family named "Helvetica" is installed.</p>
                    <p>
                        <b>Important:</b>
                        Unless the PDF standard font "Helvetica" is selected (here or as the default font), the following applies. A font named here is binding: if it is not found or cannot be embedded, or if it cannot display a character, the signature ends with an error. If the font named here is not installed, the replacement font configured for it (<code>webservices/fontSubstitution</code> in <code>application.xml</code>) is used instead, if it is installed; it is binding in the same way. Without a font named here, a character that no font of the server can display ends the signature with an error. A text that does not fit into the signature field even at the smallest font size ends it with an error as well. Characters of scripts that are written right to left or need contextual shaping (for example Arabic, Hebrew, Hindi or Thai) are drawn one by one, without shaping and in the order in which they are given.
                    </p>
                </xs:documentation>
            </xs:annotation>
        </xs:attribute>
    </xs:complexType>
    <xs:simpleType name="SignatureImagePositionType">
        <xs:annotation>
            <xs:documentation>
                <p>Position of image within signature field:
                    <ul>
                        <li>center = Centred</li>
                        <li>left = Left</li>
                        <li>right = Right</li>
                    </ul>
                </p>
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="center"/>
            <xs:enumeration value="left"/>
            <xs:enumeration value="right"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:complexType name="SignatureFileDataType">
        <xs:annotation>
            <xs:documentation>
                <p>An image that will be placed in the field's background. The data will be passed in Base64. In order to ensure that the image will have the best possible appearance, it should be transparent (e.g., PNG).</p>
            </xs:documentation>
        </xs:annotation>
        <xs:simpleContent>
            <xs:extension base="xs:base64Binary">
                <xs:attributeGroup ref="tns:FileDataGroup"/>
            </xs:extension>
        </xs:simpleContent>
    </xs:complexType>
</xs:schema>